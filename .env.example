APP_NAME=Central Authentication Service
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://auth:change-me@db:5432/central_auth
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ISSUER=internal-auth
ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:8080
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.internal
DEFAULT_ADMIN_PASSWORD=change-this-immediately
DEFAULT_ADMIN_FULL_NAME=Central Auth Administrator
HELPDESK_HEALTH_URL=
NMS_HEALTH_URL=
ATTENDANCE_HEALTH_URL=
INTRANET_HEALTH_URL=
BIC_MAILER_HEALTH_URL=
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_URL_BASE=http://localhost:8080
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Central Authentication Service
SMTP_USE_TLS=true
SMTP_USE_SSL=false
CONNECTION_CHECK_TIMEOUT_SECONDS=3
CONNECTION_CHECK_VERIFY_TLS=true
